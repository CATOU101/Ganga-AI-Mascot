# ==============================================================================
# Git Ignore Configuration for Chacha AI Avatar Project
# ==============================================================================

# --- Unity Temporary & Generated Directories ---
[0-9]*_Unity/[Ll]ibrary/
[0-9]*_Unity/[Tt]emp/
[0-9]*_Unity/[Oo]bj/
[0-9]*_Unity/[Bb]uild/
[0-9]*_Unity/[Bb]uilds/
[0-9]*_Unity/[Ll]ogs/
[0-9]*_Unity/[Uu]ser[Ss]ettings/
[0-9]*_Unity/[Mm]emoryCaptures/
[0-9]*_Unity/Recordings/
[0-9]*_Unity/Assets/_Recovery/
**/_Recovery/

# Unity generated project files (auto-generated by IDEs)
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity crash reports & memory profiler
sysinfo.txt
*.stackdump

# --- Blender Backup & Temporary Files ---
*.blend1
*.blend2
*.blend3
*.blend4
*.blend5
*.blend@
*.blend_backup*

# --- Python Cache & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage

# --- Operating System Files ---
[Dd]esktop.ini
[Tt]humbs.db
[Tt]humbs.db:encryptable
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
*.tmp
*.bak
*.swp
*~

# --- Secrets, Credentials & Local Environment Files ---
.env
.env.*
*.pem
*.key
*.cert
*.crt
id_rsa
id_rsa.pub
*.secret
secrets.json
local_settings.py

# --- Explicitly Keep Important Source Assets ---
!*.blend
!*.fbx
!*.meta
!*.unity
!*.prefab
!*.controller
!*.mat
!*.asset
!*.cs
!*.wav
!*.json
!*.md
!*.png
!*.py
