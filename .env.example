LLM_PROVIDER=groq
LLM_PROVIDER_ORDER=groq,openrouter
GANGA_BRAIN_TOP_K=5
GANGA_BRAIN_EVIDENCE_MAX_DISTANCE=1.35

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Bounded LLM budgets. Requested formats/details select an appropriate output cap.
GANGA_LLM_TOKENS_GENERAL=160
GANGA_LLM_TOKENS_SIMPLE=300
GANGA_LLM_TOKENS_DETAILED=600
GANGA_LLM_TOKENS_COMPARISON=500
GANGA_LLM_TOKENS_COMPLEX=900
GANGA_LLM_MAX_CONTEXT_CHARS=6000
GANGA_LLM_MAX_GENERAL_QUESTION_CHARS=2000
# Optional per-million-token rates enable cost estimates in server logs.
# GANGA_LLM_INPUT_COST_USD_PER_1M_TOKENS=
# GANGA_LLM_OUTPUT_COST_USD_PER_1M_TOKENS=

# Optional multilingual speech. Install requirements-speech.txt first. Azure
# Speech covers all 13 configured Indian locales for STT/TTS; provide both
# values to enable it. With STT_PROVIDER=auto,
# Azure is preferred when configured, otherwise the existing Vosk en/hi models
# are used when installed. Browser speech support varies by browser/device.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
STT_PROVIDER=auto
TTS_PROVIDER=edge

# Optional official Google Cloud Translation API key. If unset, compatibility
# behavior uses the undocumented public Translate endpoint. Translation may send
# user questions and generated answers to Google.
GOOGLE_TRANSLATE_API_KEY=

# Translation has no environment key/enable switch. API routes allow external
# translation by default when needed; API clients can opt out per request with
# translation_consent=false. The chat UI has no consent checkbox.

# The project-root .env is loaded at startup; exported variables take precedence.
