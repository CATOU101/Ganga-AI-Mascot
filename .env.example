LLM_PROVIDER=groq
LLM_PROVIDER_ORDER=groq,openrouter
GANGA_BRAIN_TOP_K=5
GANGA_BRAIN_EVIDENCE_MAX_DISTANCE=1.35

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Translation has no environment key/enable switch. API routes allow external
# translation by default when needed; API clients can opt out per request with
# translation_consent=false. The chat UI has no consent checkbox.

# The project-root .env is loaded at startup; exported variables take precedence.
