LLM_PROVIDER=groq
GANGA_BRAIN_TOP_K=5
GANGA_BRAIN_EVIDENCE_MAX_DISTANCE=1.35

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Translation Configuration
# Options: 'google_cloud' (production candidate) or 'gtx' (zero-credential fallback)
TRANSLATION_PROVIDER=gtx
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_MAX_RETRIES=3
TRANSLATION_INITIAL_DELAY=0.2
TRANSLATION_MAX_DELAY=8.0

# The application reads process environment variables; export this file before startup.